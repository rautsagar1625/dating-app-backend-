# ── Backup infrastructure env vars ───────────────────────────────────────────
# Copy to .env and fill in values. Never commit the filled-in version.

# ── S3 / Storage ──────────────────────────────────────────────────────────────
BACKUP_S3_BUCKET=velvet-backups-prod
BACKUP_S3_STORAGE_CLASS=STANDARD_IA       # STANDARD_IA saves ~40% vs STANDARD for infrequent-access data
BACKUP_KMS_KEY_ID=arn:aws:kms:us-east-1:123456789012:key/mrk-xxxxxxxx

# ── Encryption ────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
BACKUP_ENCRYPTION_KEY=change-me-use-openssl-rand-hex-32

# ── AWS credentials (use IAM role in K8s — set here only for local dev) ───────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# ── WAL-G (PostgreSQL continuous backup) ──────────────────────────────────────
WALG_S3_PREFIX=s3://velvet-backups-prod/walg
WALG_COMPRESSION_METHOD=lz4
WALG_RETAIN_FULL_BACKUPS=7
# Generate with: openssl rand -hex 32
WALG_LIBSODIUM_KEY=change-me-use-openssl-rand-hex-32

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_RDB_PATH=/data/dump.rdb

# ── Media ──────────────────────────────────────────────────────────────────────
MEDIA_LOCAL_PATH=/app/uploads
MEDIA_S3_STORAGE_CLASS=STANDARD

# ── Notifications ──────────────────────────────────────────────────────────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T.../B.../xxx
NOTIFY_ON_SUCCESS=false          # set true to get a Slack message on every successful backup

# ── Restore test ──────────────────────────────────────────────────────────────
RESTORE_TEST_RTO_MINUTES=30      # alert if restore takes longer than this

# ── Environment tag ───────────────────────────────────────────────────────────
VELVET_ENV=production
